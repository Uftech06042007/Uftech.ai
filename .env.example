# Public base URL of this deployment — used for Open Graph tags,
# the sitemap and robots.txt. Set to your real production URL.
NEXT_PUBLIC_SITE_URL=https://uftech.ai

# Resend (https://resend.com) — used by the contact form to send mail.
RESEND_API_KEY=

# Sender must be on a domain verified in Resend. Falls back to Resend's
# shared onboarding@resend.dev sandbox address if unset.
CONTACT_FROM_EMAIL="UFTECH.AI Website <onboarding@resend.dev>"

# Where contact form submissions land. Defaults to info@uftech.com.
CONTACT_TO_EMAIL=info@uftech.com
