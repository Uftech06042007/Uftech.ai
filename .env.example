# Copy this file to .env.local and fill in real values for local development.
# .env.local is gitignored and overrides everything below — see the
# "Environment variables" section of README.md for load order and what
# must change before a production deploy.
#
# NEXT_PUBLIC_SITE_URL, RESEND_API_KEY, CONTACT_TO_EMAIL, ANTHROPIC_API_KEY
# and DATABASE_URL are required once NODE_ENV=production — instrumentation.ts
# (see lib/env.ts) refuses to start the server if any of them are missing.
# Everything else is optional and has a working default.

# ---- Site ----

# Public base URL of this deployment — used for Open Graph tags, the
# sitemap and robots.txt. Defaults to http://localhost:3000 if unset.
# Set to the real production URL before deploying.
NEXT_PUBLIC_SITE_URL=

# ---- Lead delivery (contact form + chatbot) ----
# Shared by both capture paths — see lib/leads.ts.

# Resend (https://resend.com) API key. Leave blank to have leads fail
# gracefully with a "please email us directly" message instead of sending.
RESEND_API_KEY=

# Sender must be on a domain verified in Resend. Falls back to Resend's
# shared onboarding@resend.dev sandbox address if unset.
CONTACT_FROM_EMAIL="UFTECH.AI Website <onboarding@resend.dev>"

# Where lead notifications land. Defaults to info@uftech.com if unset.
CONTACT_TO_EMAIL=

# ---- Site assistant (chatbot) ----
# The endpoint is Anthropic-compatible but need not be Anthropic — it
# currently points at DeepSeek. Switching provider is a config change, not
# a code change. See the chatbot specification in AGENTS.md.

ANTHROPIC_API_KEY=
# Leave blank to talk to Anthropic directly; set to a compatible endpoint
# otherwise (e.g. https://api.deepseek.com/anthropic).
ANTHROPIC_BASE_URL=
# Model used for chat replies. Defaults to claude-sonnet-5 if unset.
AI_MODEL=
# Model used for the cheaper follow-up-suggestion call. Falls back to
# AI_MODEL, then claude-haiku-4-5, if unset.
AI_MODEL_FAST=

# ---- Rate limiting (/api/chat and /api/lead) ----
# Both limiters default to on in production and off in development.
# Leave the *_ENABLED flags blank to keep that default; set to
# true/false to override it explicitly. See lib/rate-limit.ts.

# General per-visitor guard on both endpoints.
CHAT_RATE_LIMIT_ENABLED=
# Max requests per visitor per window before a 429. Defaults to 30 if unset.
CHAT_RATE_LIMIT_MAX=
# Window length in milliseconds. Defaults to 60000 (1 minute) if unset.
CHAT_RATE_LIMIT_WINDOW_MS=

# Stricter throttle for /api/chat only, applied on top of the general limit
# above but just to visitors who already have a Lead on file (identified via
# the uft_visitor_id cookie). Two independent windows, both checked on every
# request — a short burst cap and a longer sustained cap.
CHAT_CONVERTED_RATE_LIMIT_ENABLED=
# Max chat requests per burst window. Defaults to 3 if unset.
CHAT_CONVERTED_RATE_LIMIT_BURST_MAX=
# Burst window length in milliseconds. Defaults to 60000 (1 minute) if unset.
CHAT_CONVERTED_RATE_LIMIT_BURST_WINDOW_MS=
# Max chat requests per sustained window. Defaults to 10 if unset.
CHAT_CONVERTED_RATE_LIMIT_MAX=
# Sustained window length in milliseconds. Defaults to 3600000 (1 hour) if unset.
CHAT_CONVERTED_RATE_LIMIT_WINDOW_MS=

# ---- Database ----

# Postgres connection string used by Prisma to store anonymous visitor
# tracking (on cookie-accept) and leads from both capture paths. Tables
# live in their own "uftech_ai" Postgres schema (see prisma/schema.prisma)
# — safe to point this at a database shared with other apps, since
# nothing outside that schema is ever touched.
DATABASE_URL=
